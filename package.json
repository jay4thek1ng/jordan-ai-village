{
  "name": "agent-village",
  "version": "0.1.0",
  "description": "Jordan AI Village: Jesse's bots, each in a cozy miniature room",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "collect": "python3 collector/collect.py",
    "serve": "node server.mjs 5178",
    "start": "scripts/start.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && python3 -m unittest discover -s collector -p \"test_*.py\"",
    "shot": "node scripts/shot.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:pages": "scripts/build-pages.sh",
    "build:cf": "scripts/build-cf.sh",
    "snapshot": "python3 collector/snapshot.py",
    "privacy": "node scripts/privacy.mjs site"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.7",
    "eslint": "^10.15.0",
    "playwright-core": "^1.65.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.4.6",
    "vitest": "^5.1.1"
  },
  "private": true
}
